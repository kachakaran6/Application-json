# Master password / key to unlock editing, adding, and deleting apps in the web studio
ADMIN_SECRET=your_secure_admin_password

# GitHub Integration (Optional - needed if committing directly to GitHub on Vercel or Coolify)
# Create a GitHub Personal Access Token at https://github.com/settings/tokens (with 'repo' scope or 'Contents: Read & write')
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# GitHub Repository details (defaults to current repo if omitted)
GITHUB_OWNER=kachakaran6
GITHUB_REPO=Application-json
GITHUB_BRANCH=main
